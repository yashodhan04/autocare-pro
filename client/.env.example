# Environment variables for AutoCare Pro Client (Vite)
# Copy this file to .env or .env.local if custom configuration is required.
# NEVER commit real credentials or secrets to version control.

# ── API Backend URL ─────────────────────────────────────────
# Default points to the local Express server API
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# Leave unset in development: Vite proxies /api to the Express server (see vite.config.js).
