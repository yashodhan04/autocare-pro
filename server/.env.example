# Environment variables for AutoCare Pro Server
# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# MySQL 8 — mysql://USER:PASSWORD@HOST:PORT/DATABASE (create the empty database first)
DATABASE_URL=mysql://autocare:change_me@127.0.0.1:3306/autocare_pro
# Separate DB used by `npm test` (it is DROPPED and recreated on every run — never point it at real data)
DATABASE_URL_TEST=mysql://autocare:change_me@127.0.0.1:3306/autocare_pro_test

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Workshop scheduling rules
WORKSHOP_OPEN_HOUR=8
WORKSHOP_CLOSE_HOUR=18
WORKSHOP_BAYS=3
# Default tax rate (%) for estimates / invoices
DEFAULT_TAX_RATE=18
