# Environment variables for AutoCare Pro Server
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/autocare_pro
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autocare_pro
MONGODB_URI=mongodb://localhost:27017/autocare_pro

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ── Future — add when implementing these features ────────────
# JWT_SECRET=change_this_to_a_long_random_secret
# JWT_EXPIRES_IN=7d
